{
  "name": "ai-crawler",
  "version": "0.1.0",
  "description": "LLM-assisted web extraction: a fluent builder declares entities/fields (including nested objects and repeating arrays), the LLM proposes CSS selectors, and each candidate is verified against the page before values are persisted.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names workflow,app,web --prefix-colors blue,green,magenta \"npm:workflow:dev\" \"npm:app:dev\" \"npm:web:dev\"",
    "workflow:dev": "node --watch workflow/server/index.js",
    "app:dev": "node --watch app/index.js",
    "web:dev": "vite",
    "demo": "tsx --env-file=.env index.js",
    "build": "esbuild index.js --bundle --platform=node --target=node22 --packages=external --outfile=dist/index.js",
    "web:build": "vite build",
    "web:preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.10",
    "@sparticuz/chromium-min": "^147.0.0",
    "ai": "^7.0.28",
    "cheerio": "^1.1.2",
    "express": "^5.3.0",
    "markitdown-ts": "^0.0.10",
    "puppeteer": "^25.3.0",
    "puppeteer-core": "^25.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sqlite3": "^6.0.1",
    "styled-components": "^6.5.3",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "license": "UNLICENSED"
}
